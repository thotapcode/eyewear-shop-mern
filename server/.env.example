PORT=3000
# Chuỗi kết nối MongoDB Atlas, dạng mongodb+srv://<user>:<mật khẩu>@<cluster>/<tên_db>
MONGODB_URI=
# Khóa ký token đăng nhập, đặt chuỗi ngẫu nhiên dài (bắt buộc khi chạy production)
JWT_SECRET=
# Tài khoản gửi email kích hoạt (Gmail kèm App Password). Để trống thì liên kết kích hoạt được in ra cửa sổ chạy server
EMAIL_USER=
EMAIL_PASS=
# Địa chỉ trang khách, dùng để tạo liên kết kích hoạt trong email
CLIENT_URL=http://localhost:3002
# Tài khoản admin được tạo lần chạy đầu tiên khi bảng admin còn trống (ADMIN_PASSWORD bắt buộc khi chạy production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Đặt production khi triển khai để server phục vụ luôn bản build của hai trang web
# NODE_ENV=production
